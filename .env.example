# Copy this file to .env.local and fill in the values. Never commit .env.local.

# --- Vapi (voice agent) — dashboard.vapi.ai → Organization → API Keys ---
VAPI_PRIVATE_KEY=            # "Private key". Server only. Used by scripts/setup-vapi.ts
NEXT_PUBLIC_VAPI_PUBLIC_KEY= # "Public key". Safe in the browser. Used for the web call
VAPI_ASSISTANT_ID=           # Printed by scripts/setup-vapi.ts (or dashboard → Assistants)
VAPI_SERVER_SECRET=          # Any long random string you make up. Vapi sends it to /api/vapi
NEXT_PUBLIC_SEMA_PHONE=      # The phone number people can call, e.g. +1 555 123 4567 (dashboard → Phone Numbers)

# --- SMS (Twilio) — console.twilio.com ---
TWILIO_ACCOUNT_SID=          # Console home page → Account Info
TWILIO_AUTH_TOKEN=           # Console home page → Account Info
TWILIO_FROM=                 # Your Twilio number or Messaging Service SID
ALLOWED_NUMBERS=             # Comma-separated numbers Sema may text, e.g. +254712345678,+254798765432
DEMO_PHONE_NUMBER=           # Number to text during web calls (no caller ID), e.g. +254712345678

# --- Email (Gmail) — myaccount.google.com/apppasswords (needs 2-Step Verification on) ---
GMAIL_USER=                  # e.g. sema.demo@gmail.com
GMAIL_APP_PASSWORD=          # 16-letter app password

# --- Gemini (rumour check) — aistudio.google.com/apikey ---
GEMINI_API_KEY=

# --- Tavily (web search for search_web) — app.tavily.com → API Keys (free tier) ---
TAVILY_API_KEY=

# --- Upstash (storage + delayed reminders) — Vercel → Storage → Marketplace → Upstash ---
UPSTASH_REDIS_REST_URL=      # Optional locally: without it, data is kept in memory
UPSTASH_REDIS_REST_TOKEN=
QSTASH_TOKEN=                # console.upstash.com → QStash

# --- App ---
APP_URL=                     # Your Vercel URL, e.g. https://sema-ai.vercel.app (no trailing slash)
